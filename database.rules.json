        ".validate": "newData.hasChildren(['email','lastSeen'])",
        "email": {
          ".validate": "newData.val() === auth.token.email"
        },
        "lastSeen": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "completed": {
          ".validate": "newData.hasChildren()",
          "aiml": {
            ".validate": "newData.hasChildren()",
            "$lesson": {
              ".validate": "$lesson.matches(/^(ai-sys|ai-kb|ai-pred|ai-tokens|ai-check|ai-zero|ai-churn)$/) && newData.isNumber() && newData.val() === now"
            }
          },
