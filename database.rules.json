{
  "rules": {
    ".read": false,
    ".write": false,
    "students": {
      ".read": "auth != null && auth.uid === 'cqYV6YMFt3TOdUfP37su7rSZQuL2' && auth.token.firebase.sign_in_provider === 'password'",
      "$uid": {
        ".read": "(auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.token.email_verified === true && auth.token.email.matches(/^[^@ ]+@chitkara[.]edu[.]in$/)) && auth.uid === $uid",
